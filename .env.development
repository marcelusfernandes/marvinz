# Enables the native chat UI in development. Release builds (vite build) leave
# this unset so the chat UI is gated out until Chat v1 ships. See
# src/lib/featureFlags.ts and issue #241.
VITE_CHAT_UI_ENABLED=true

# Enables the redesigned Modern visual style in development. Release builds
# leave this unset so the app stays on Legacy until Modern is promoted to GA.
# See src/lib/featureFlags.ts and issue #276.
VITE_MODERN_UI_ENABLED=true
