# Enables the native chat UI in development. Release builds (vite build) leave
# this unset so the chat UI is gated out until Chat v1 ships. See
# src/lib/featureFlags.ts and issue #241.
VITE_CHAT_UI_ENABLED=true

# Enables Office (Excel/Word) editing + save in development. Release builds
# (vite build) leave this unset so editing is gated out while it is still under
# development; the read-only preview stays available. See
# src/lib/featureFlags.ts and issue #429.
VITE_OFFICE_EDIT_ENABLED=true
